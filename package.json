{
  "name": "manipulador-de-alimentos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm tokens && tsc -b && vite build",
    "lint": "oxlint && stylelint \"src/**/*.css\" && node scripts/check-css-vars.ts",
    "preview": "vite preview",
    "placeholders": "node scripts/generate-placeholders.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "pnpm tokens && storybook build",
    "tokens": "node scripts/build-tokens.ts",
    "lint:css": "stylelint \"src/**/*.css\"",
    "package": "pnpm build && tramoya scorm --title 'Manipulador de alimentos'"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@studiolxd/tramoya": "https://github.com/studiolxd/tramoya/releases/download/v0.3.0/studiolxd-tramoya-0.3.0.tgz",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "storybook": "^10.6.3",
    "style-dictionary": "5.7.0",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.18.0"
}
