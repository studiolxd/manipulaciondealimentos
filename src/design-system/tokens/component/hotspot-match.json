{
  "hotspot-match": {
    "$description": "Match list items to hidden points of a picture (HotspotMatch).",
    "gap": {
      "$type": "dimension",
      "$value": "{space.sm}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.sm}"
    },
    "item-gap": {
      "$type": "dimension",
      "$value": "{space.2xs}"
    },
    "list-width": {
      "$type": "dimension",
      "$value": "{size.choice.min-width}",
      "$description": "Width of each of the two columns of the list."
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.outline}"
    },
    "border-color": {
      "$type": "color",
      "$value": "{color.border.ink}"
    },
    "dragging-opacity": {
      "$type": "number",
      "$value": "{opacity.muted}"
    },
    "ghost-background": {
      "$type": "color",
      "$value": "{color.action.primary.background}"
    },
    "ghost-text": {
      "$type": "color",
      "$value": "{color.action.primary.text}"
    },
    "ghost-padding-block": {
      "$type": "dimension",
      "$value": "{space.xs}"
    },
    "ghost-padding-inline": {
      "$type": "dimension",
      "$value": "{space.sm}"
    },
    "ghost-shadow-offset": {
      "$type": "dimension",
      "$value": "{space.2xs}"
    }
  }
}
