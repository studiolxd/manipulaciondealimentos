{
  "surface": {
    "$description": "Base panel of every box: bubbles, dialogs, cards, feedback.",
    "text": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{shadow.raised}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.strong}"
    },
    "border-color": {
      "$type": "color",
      "$value": "{color.border.none}"
    },
    "border-color-highlighted": {
      "$type": "color",
      "$value": "{color.border.selected}"
    },
    "opaque": {
      "background": {
        "$type": "color",
        "$value": "{color.surface.default}"
      }
    },
    "translucent": {
      "background": {
        "$type": "color",
        "$value": "{color.surface.translucent}"
      }
    },
    "paper": {
      "background": {
        "$type": "color",
        "$value": "{color.surface.paper}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border.subtle}"
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{border-width.default}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      }
    },
    "padding": {
      "sm": {
        "block": {
          "$type": "dimension",
          "$value": "{space.md}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{space.xl}"
        }
      },
      "md": {
        "block": {
          "$type": "dimension",
          "$value": "{space.lg}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{space.xl}"
        }
      },
      "lg": {
        "block": {
          "$type": "dimension",
          "$value": "{space.xl}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{space.2xl}"
        }
      },
      "xl": {
        "block": {
          "$type": "dimension",
          "$value": "{space.2xl}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{space.4xl}"
        }
      }
    },
    "tail": {
      "base": {
        "$type": "dimension",
        "$value": "{space.3xl}"
      },
      "length": {
        "$type": "dimension",
        "$value": "{space.xl}"
      },
      "offset": {
        "$type": "dimension",
        "$value": "{space.5xl}",
        "$description": "Distance from the corner to the tail."
      }
    }
  }
}
