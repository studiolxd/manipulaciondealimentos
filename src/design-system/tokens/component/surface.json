{
  "surface": {
    "$description": "Base panel of every box: bubbles, dialogs, cards, feedback, narration.",
    "text": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{shadow.raised}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.outline}"
    },
    "border-color": {
      "$type": "color",
      "$value": "{color.border.ink}"
    },
    "highlight-width": {
      "$type": "dimension",
      "$value": "calc({border-width.outline} * 2)",
      "$description": "Extra ring around a selected surface, twice the outline so selection does not rely on colour alone."
    },
    "highlight-color": {
      "$type": "color",
      "$value": "{color.border.selected}"
    },
    "opaque": {
      "background": {
        "$type": "color",
        "$value": "{color.surface.default}"
      }
    },
    "ink": {
      "background": {
        "$type": "color",
        "$value": "{color.surface.ink}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.inverse}"
      }
    },
    "paper": {
      "background": {
        "$type": "color",
        "$value": "{color.surface.paper}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      }
    },
    "accent": {
      "width": {
        "$type": "dimension",
        "$value": "{border-width.band}"
      },
      "positive": {
        "$type": "color",
        "$value": "{color.feedback.positive}"
      },
      "negative": {
        "$type": "color",
        "$value": "{color.feedback.negative}"
      }
    },
    "padding": {
      "sm": {
        "block": {
          "$type": "dimension",
          "$value": "{space.md}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{space.xl}"
        }
      },
      "md": {
        "block": {
          "$type": "dimension",
          "$value": "{space.lg}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{space.xl}"
        }
      },
      "lg": {
        "block": {
          "$type": "dimension",
          "$value": "{space.xl}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{space.2xl}"
        }
      },
      "xl": {
        "block": {
          "$type": "dimension",
          "$value": "{space.2xl}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{space.4xl}"
        }
      }
    },
    "tail": {
      "overlap": {
        "$type": "dimension",
        "$value": "calc({border-width.outline} / 3)",
        "$description": "1 real pixel: the tail fill reaches into the bubble so no seam shows where they meet."
      },
      "base": {
        "$type": "dimension",
        "$value": "{space.3xl}"
      },
      "length": {
        "$type": "dimension",
        "$value": "{space.xl}"
      },
      "offset": {
        "$type": "dimension",
        "$value": "{space.5xl}",
        "$description": "Distance from the corner to the tail."
      }
    }
  }
}
