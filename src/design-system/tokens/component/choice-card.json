{
  "choice-card": {
    "background": {
      "$type": "color",
      "$value": "{color.surface.translucent}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "border-color": {
      "$type": "color",
      "$value": "{color.border.none}"
    },
    "border-color-selected": {
      "$type": "color",
      "$value": "{color.border.selected}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.strong}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.md}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.sm}"
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.bold}"
    },
    "group-gap": {
      "$type": "dimension",
      "$value": "{space.5xl}"
    }
  }
}
