{
  "heading": {
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.display}"
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.display-strong}"
    },
    "letter-spacing": {
      "$type": "dimension",
      "$value": "{font.letter-spacing.caps}"
    },
    "line-height": {
      "$type": "number",
      "$value": "{font.line-height.snug}"
    },
    "subheading": {
      "$description": "Names (e.g. on ID cards): in the prose family, bold, as written.",
      "font-family": {
        "$type": "fontFamily",
        "$value": "{font.family.body}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.bold}"
      }
    },
    "size": {
      "display": {
        "$type": "dimension",
        "$value": "{font.size.display}"
      },
      "heading": {
        "$type": "dimension",
        "$value": "{font.size.heading}"
      },
      "subheading": {
        "$type": "dimension",
        "$value": "{font.size.subheading}"
      },
      "system": {
        "$type": "dimension",
        "$value": "{font.size.system-heading}"
      }
    },
    "overlay": {
      "$description": "Headings placed straight over the scene: light text, no outline.",
      "text": {
        "$type": "color",
        "$value": "{color.text.inverse}"
      }
    }
  }
}
