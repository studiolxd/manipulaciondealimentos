{
  "activity-title": {
    "hold-duration": {
      "$type": "duration",
      "$value": "{motion.duration.title-hold}"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": "{motion.easing.exit}"
    },
    "shadow-offset": {
      "$type": "dimension",
      "$value": "{space.2xs}",
      "$description": "A hard shadow under the letters, only on the activity titles."
    },
    "shadow-color": {
      "$type": "color",
      "$value": "{color.shadow.default}"
    }
  }
}
