{
  "activity-title": {
    "background": {
      "$type": "color",
      "$value": "{color.surface.translucent}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{space.lg}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.5xl}"
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.display}"
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.display-strong}"
    },
    "line-height": {
      "$type": "number",
      "$value": "{font.line-height.snug}"
    },
    "hold-duration": {
      "$type": "duration",
      "$value": "{motion.duration.title-hold}"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": "{motion.easing.exit}"
    },
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.display}"
    }
  }
}
