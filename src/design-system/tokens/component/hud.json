{
  "hud": {
    "height": {
      "$type": "dimension",
      "$value": "{size.hud.height}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.inverse}"
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.display}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.xl}"
    },
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.display}"
    }
  }
}
