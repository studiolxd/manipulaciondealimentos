{
  "hud": {
    "height": {
      "$type": "dimension",
      "$value": "{size.hud.height}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.xl}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.md}"
    },
    "background": {
      "$type": "color",
      "$value": "{color.surface.glass}"
    },
    "blur": {
      "$type": "dimension",
      "$value": "{blur.glass}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.outline}"
    },
    "border-color": {
      "$type": "color",
      "$value": "{color.border.ink}"
    }
  }
}
