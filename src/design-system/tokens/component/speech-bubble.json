{
  "speech-bubble": {
    "background": { "$type": "color", "$value": "{color.surface.default}" },
    "text": { "$type": "color", "$value": "{color.text.default}" },
    "radius": { "$type": "dimension", "$value": "{radius.lg}" },
    "padding-block-start": { "$type": "dimension", "$value": "{space.xl}" },
