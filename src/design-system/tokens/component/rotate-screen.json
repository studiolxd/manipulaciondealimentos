{
  "rotate-screen": {
    "$description": "Shown outside the stage, so its sizes are real screen pixels from the primitive screen minimums.",
    "background": {
      "$type": "color",
      "$value": "{color.surface.inverse}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.inverse}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.xs}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.sm}"
    }
  }
}
