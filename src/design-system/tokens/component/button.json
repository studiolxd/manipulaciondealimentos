{
  "button": {
    "min-height": {
      "$type": "dimension",
      "$value": "{size.target.min}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{space.xs}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.4xl}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}",
      "$description": "The same as text inputs."
    },
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.display}"
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.body}"
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.control}"
    },
    "letter-spacing": {
      "$type": "dimension",
      "$value": "{font.letter-spacing.caps}"
    },
    "outline-width": {
      "$type": "dimension",
      "$value": "{border-width.outline}"
    },
    "outline-color": {
      "$type": "color",
      "$value": "{color.border.ink}"
    },
    "enter": {
      "$description": "Entrance of the buttons that take the player to another scene (advance): they slide up and fade in.",
      "distance": {
        "$type": "dimension",
        "$value": "{space.xl}"
      },
      "duration": {
        "$type": "duration",
        "$value": "{motion.duration.morph}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.enter}"
      }
    },
    "lift": {
      "$description": "Every button: a hard shadow in the outline colour that grows on hover and disappears when pressed.",
      "rest": {
        "$type": "dimension",
        "$value": "{space.3xs}"
      },
      "hover": {
        "$type": "dimension",
        "$value": "{space.2xs}"
      },
      "duration": {
        "$type": "duration",
        "$value": "{motion.duration.press}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.standard}"
      }
    },
    "primary": {
      "background": {
        "$type": "color",
        "$value": "{color.action.primary.background}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.action.primary.text}"
      }
    },
    "choice": {
      "$description": "Large YES / NO answers placed over a scene.",
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.lg}"
      },
      "font-size": {
        "$type": "dimension",
        "$value": "{font.size.label-lg}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.display-strong}"
      },
      "positive": {
        "background": {
          "$type": "color",
          "$value": "{color.action.positive.background}"
        },
        "text": {
          "$type": "color",
          "$value": "{color.action.positive.text}"
        }
      },
      "negative": {
        "background": {
          "$type": "color",
          "$value": "{color.action.negative.background}"
        },
        "text": {
          "$type": "color",
          "$value": "{color.action.negative.text}"
        }
      }
    },
    "secondary": {
      "$description": "Light button for options that act as soon as they are pressed (OptionButtons).",
      "min-width": {
        "$type": "dimension",
        "$value": "{size.choice.min-width}"
      },
      "background": {
        "$type": "color",
        "$value": "{color.action.secondary.background}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.action.secondary.text}"
      }
    },
    "option": {
      "$description": "An item written as a sentence that is picked or dragged (HotspotMatch).",
      "background": {
        "$type": "color",
        "$value": "{color.surface.default}"
      },
      "pressed-background": {
        "$type": "color",
        "$value": "{color.action.primary.background}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.default}"
      },
      "done-background": {
        "$type": "color",
        "$value": "{color.action.positive.background}"
      },
      "done-text": {
        "$type": "color",
        "$value": "{color.action.positive.text}"
      },
      "min-height": {
        "$type": "dimension",
        "$value": "{size.target.compact}"
      },
      "padding-block": {
        "$type": "dimension",
        "$value": "{space.2xs}"
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.xs}"
      },
      "font-family": {
        "$type": "fontFamily",
        "$value": "{font.family.body}"
      },
      "font-size": {
        "$type": "dimension",
        "$value": "{font.size.small}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.bold}"
      },
      "line-height": {
        "$type": "number",
        "$value": "{font.line-height.snug}"
      }
    },
    "icon": {
      "$description": "Square icon-only button (IconButton), with the radius of every button.",
      "compact-size": {
        "$type": "dimension",
        "$value": "{size.target.compact}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{size.target.min}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.2xs}"
      },
      "background": {
        "$type": "color",
        "$value": "{color.action.primary.background}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.action.primary.text}"
      }
    }
  }
}
