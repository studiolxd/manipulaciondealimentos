{
  "button": {
    "min-height": {
      "$type": "dimension",
      "$value": "{size.target.min}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{space.xs}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.4xl}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}",
      "$description": "The same as text inputs."
    },
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.display}"
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.body}"
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.control}"
    },
    "letter-spacing": {
      "$type": "dimension",
      "$value": "{font.letter-spacing.caps}"
    },
    "outline-width": {
      "$type": "dimension",
      "$value": "{border-width.outline}"
    },
    "outline-color": {
      "$type": "color",
      "$value": "{color.border.ink}"
    },
    "edge-height": {
      "$type": "dimension",
      "$value": "{space.3xs}",
      "$description": "Lower edge that makes buttons look pressable; it sinks when pressed."
    },
    "shadow-color": {
      "$type": "color",
      "$value": "{color.shadow.default}"
    },
    "enter": {
      "$description": "Entrance of the buttons that take the player to another scene (advance): they slide up and fade in.",
      "distance": {
        "$type": "dimension",
        "$value": "{space.xl}"
      },
      "duration": {
        "$type": "duration",
        "$value": "{motion.duration.morph}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.enter}"
      }
    },
    "lift": {
      "$description": "Primary, secondary and icon buttons: a hard shadow in the outline colour that grows on hover and disappears when pressed.",
      "rest": {
        "$type": "dimension",
        "$value": "{space.3xs}"
      },
      "hover": {
        "$type": "dimension",
        "$value": "{space.2xs}"
      },
      "duration": {
        "$type": "duration",
        "$value": "{motion.duration.press}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.standard}"
      }
    },
    "primary": {
      "background": {
        "$type": "color",
        "$value": "{color.action.primary.background}"
      },
      "background-hover": {
        "$type": "color",
        "$value": "{color.action.primary.background-hover}"
      },
      "edge": {
        "$type": "color",
        "$value": "{color.action.primary.edge}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.action.primary.text}"
      }
    },
    "choice": {
      "$description": "Large YES / NO answers placed over a scene.",
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.lg}"
      },
      "font-size": {
        "$type": "dimension",
        "$value": "{font.size.label-lg}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.display-strong}"
      },
      "positive": {
        "background": {
          "$type": "color",
          "$value": "{color.action.positive.background}"
        },
        "background-hover": {
          "$type": "color",
          "$value": "{color.action.positive.background-hover}"
        },
        "edge": {
          "$type": "color",
          "$value": "{color.action.positive.edge}"
        },
        "text": {
          "$type": "color",
          "$value": "{color.action.positive.text}"
        }
      },
      "negative": {
        "background": {
          "$type": "color",
          "$value": "{color.action.negative.background}"
        },
        "background-hover": {
          "$type": "color",
          "$value": "{color.action.negative.background-hover}"
        },
        "edge": {
          "$type": "color",
          "$value": "{color.action.negative.edge}"
        },
        "text": {
          "$type": "color",
          "$value": "{color.action.negative.text}"
        }
      }
    },
    "secondary": {
      "$description": "Light button for options that act as soon as they are pressed (OptionButtons).",
      "min-width": {
        "$type": "dimension",
        "$value": "{size.choice.min-width}"
      },
      "background": {
        "$type": "color",
        "$value": "{color.action.secondary.background}"
      },
      "background-hover": {
        "$type": "color",
        "$value": "{color.action.secondary.background-hover}"
      },
      "edge": {
        "$type": "color",
        "$value": "{color.action.secondary.edge}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.action.secondary.text}"
      }
    },
    "icon": {
      "$description": "Round icon-only button (IconButton).",
      "radius": {
        "$type": "dimension",
        "$value": "{radius.full}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{size.target.min}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.2xs}"
      },
      "background": {
        "$type": "color",
        "$value": "{color.action.primary.background}"
      },
      "background-hover": {
        "$type": "color",
        "$value": "{color.action.primary.background-hover}"
      },
      "edge": {
        "$type": "color",
        "$value": "{color.action.primary.edge}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.action.primary.text}"
      }
    }
  }
}
