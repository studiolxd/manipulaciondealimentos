{
  "label": {
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.display}"
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.display}"
    },
    "letter-spacing": {
      "$type": "dimension",
      "$value": "{font.letter-spacing.caps}"
    },
    "size": {
      "md": {
        "$type": "dimension",
        "$value": "{font.size.body}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{font.size.label-lg}"
      }
    },
    "inverse-text": {
      "$type": "color",
      "$value": "{color.text.inverse}"
    }
  }
}
