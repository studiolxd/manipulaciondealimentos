{
  "switch": {
    "$description": "On / off setting in the style of the buttons.",
    "gap": {
      "$type": "dimension",
      "$value": "{space.xl}"
    },
    "min-height": {
      "$type": "dimension",
      "$value": "{size.target.min}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.display}"
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.body}"
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.control}"
    },
    "letter-spacing": {
      "$type": "dimension",
      "$value": "{font.letter-spacing.caps}"
    },
    "track-width": {
      "$type": "dimension",
      "$value": "{size.switch.width}"
    },
    "track-height": {
      "$type": "dimension",
      "$value": "{size.switch.height}"
    },
    "thumb-size": {
      "$type": "dimension",
      "$value": "{size.switch.thumb}"
    },
    "thumb-inset": {
      "$type": "dimension",
      "$value": "{space.2xs}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.full}"
    },
    "outline-width": {
      "$type": "dimension",
      "$value": "{border-width.outline}"
    },
    "outline-color": {
      "$type": "color",
      "$value": "{color.border.ink}"
    },
    "shadow-offset": {
      "$type": "dimension",
      "$value": "{space.3xs}"
    },
    "off-background": {
      "$type": "color",
      "$value": "{color.surface.default}"
    },
    "on-background": {
      "$type": "color",
      "$value": "{color.action.primary.background}"
    },
    "duration": {
      "$type": "duration",
      "$value": "{motion.duration.press}"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": "{motion.easing.standard}"
    }
  }
}
