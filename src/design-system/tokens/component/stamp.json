{
  "stamp": {
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.md}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{space.3xs}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.strong}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.sm}"
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.stamp}"
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.display-strong}"
    },
    "line-height": {
      "$type": "number",
      "$value": "{font.line-height.tight}"
    },
    "positive": {
      "$type": "color",
      "$value": "{color.feedback.positive}"
    },
    "negative": {
      "$type": "color",
      "$value": "{color.feedback.negative}"
    },
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.display}"
    }
  }
}
