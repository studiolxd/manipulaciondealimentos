{
  "text-input": {
    "min-height": {
      "$type": "dimension",
      "$value": "{size.target.min}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.md}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.outline}"
    },
    "border-color": {
      "$type": "color",
      "$value": "{color.border.ink}"
    },
    "background": {
      "$type": "color",
      "$value": "{color.surface.paper}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.body}"
    },
    "invalid-border-color": {
      "$type": "color",
      "$value": "{color.feedback.negative}"
    }
  }
}