{
  "primitive": {
    "shadow": {
      "$type": "shadow",
      "lg": {
        "$value": {
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "48px",
          "spread": "0px",
          "color": "{primitive.color.black-alpha.25}"
        }
      }
    },
    "duration": {
      "$type": "duration",
      "28": { "$value": "28ms" },
      "350": { "$value": "350ms" },
      "450": { "$value": "450ms" },
      "600": { "$value": "600ms" },
      "2500": { "$value": "2500ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "ease-in-out": { "$value": [0.42, 0, 0.58, 1] },
      "ease-out": { "$value": [0, 0, 0.58, 1] },
      "ease-in": { "$value": [0.42, 0, 1, 1] }
    },
    "z-index": {
      "$type": "number",
      "0": { "$value": 0 },
      "1": { "$value": 1 },
      "2": { "$value": 2 },
      "3": { "$value": 3 },
      "10": { "$value": 10 }
    }
  }
}
