{
  "color": {
    "$type": "color",
    "text": {
      "default": {
        "$value": "{primitive.color.neutral.900}"
      },
      "inverse": {
        "$value": "{primitive.color.white}"
      },
      "positive": {
        "$value": "{primitive.color.green.700}"
      },
      "negative": {
        "$value": "{primitive.color.red.700}"
      }
    },
    "surface": {
      "default": {
        "$value": "{primitive.color.white}",
        "$description": "Opaque panels: bubbles, dialogs, feedback."
      },
      "translucent": {
        "$value": "{primitive.color.white-alpha.94}",
        "$description": "Panels laid over a scene background."
      },
      "paper": {
        "$value": "{primitive.color.sand.50}",
        "$description": "Printed-looking objects such as ID cards."
      },
      "inverse": {
        "$value": "{primitive.color.neutral.950}",
        "$description": "Full-screen system messages."
      },
      "backdrop": {
        "$value": "{primitive.color.black}",
        "$description": "Letterbox around the stage and fade curtain."
      }
    },
    "border": {
