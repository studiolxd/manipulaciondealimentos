{
  "color": {
    "$type": "color",
    "text": {
      "default": {
        "$value": "{primitive.color.petrol.900}"
      },
      "inverse": {
        "$value": "{primitive.color.white}",
        "$description": "Text on ink panels and over the scene."
      },
      "positive": {
        "$value": "{primitive.color.green.700}"
      },
      "negative": {
        "$value": "{primitive.color.red.700}"
