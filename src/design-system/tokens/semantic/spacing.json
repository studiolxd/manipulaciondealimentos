{
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale for padding, margins and gaps, in stage pixels.",
    "none": {
      "$value": "{primitive.size.0}"
    },
    "3xs": {
      "$value": "{primitive.size.4}"
    },
    "2xs": {
      "$value": "{primitive.size.8}"
    },
    "xs": {
      "$value": "{primitive.size.16}"
    },
    "sm": {
      "$value": "{primitive.size.24}"
    },
    "md": {
      "$value": "{primitive.size.32}"
    },
    "lg": {
      "$value": "{primitive.size.40}"
    },
    "xl": {
      "$value": "{primitive.size.48}"
    },
    "2xl": {
      "$value": "{primitive.size.56}"
    },
    "3xl": {
      "$value": "{primitive.size.64}"
    },
    "4xl": {
      "$value": "{primitive.size.72}"
    },
    "5xl": {
      "$value": "{primitive.size.96}"
    }
  },
  "size": {
    "$type": "dimension",
    "icon": {
      "sm": {
        "$value": "{primitive.size.48}"
      },
      "md": {
        "$value": "{primitive.size.96}"
      },
      "lg": {
        "$value": "{primitive.size.160}"
      }
    },
    "logo": {
      "splash": {
        "$value": "clamp({primitive.screen.logo-min}, 40vw, {primitive.screen.logo-max})",
        "$description": "Studio LXD logo on the splash screen: 40% of the window, between the minimum and maximum."
      }
    },
    "target": {
      "min": {
        "$value": "max({primitive.size.112}, calc({primitive.screen.target-min} / var(--slxd-stage-scale)))",
        "$description": "Minimum size of anything clickable: 112 stage px, never less than 44 real px."
      }
    },
    "avatar": {
      "$value": "{primitive.size.200}",
      "$description": "Round portrait on ID cards."
    },
    "hud": {
      "height": {
        "$value": "{primitive.size.120}"
      }
    },
    "choice": {
      "min-width": {
        "$value": "{primitive.size.400}",
        "$description": "Minimum width of a choice option, so options line up."
      }
    }
  }
}
