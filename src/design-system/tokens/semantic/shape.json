{
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "{primitive.radius.16}"
    },
    "md": {
      "$value": "{primitive.radius.32}"
    },
    "lg": {
      "$value": "{primitive.radius.40}"
    },
    "full": {
      "$value": "{primitive.radius.full}"
    }
  },
  "border-width": {
    "$type": "dimension",
    "default": {
      "$value": "{primitive.border-width.4}"
    },
    "strong": {
      "$value": "{primitive.border-width.8}"
    },
    "outline": {
      "$value": "calc({primitive.screen.outline} / var(--slxd-stage-scale))",
      "$description": "Ink outline: 3 real pixels at any stage scale."
    }
  },
  "focus": {
    "$type": "dimension",
    "ring-width": {
      "$value": "max({primitive.size.6}, calc({primitive.screen.focus-ring-min} / var(--slxd-stage-scale)))"
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": "{primitive.shadow.hard}"
    }
  },
  "blur": {
    "$type": "dimension",
    "glass": {
      "$value": "{primitive.blur.16}",
      "$description": "Background blur behind glass panels."
    }
  },
  "stroke-width": {
    "$type": "number",
    "icon": {
      "$value": "{primitive.stroke-width.1}",
      "$description": "Icon stroke in grid units: it grows with the icon, rounded to whole real pixels."
    }
  }
}
