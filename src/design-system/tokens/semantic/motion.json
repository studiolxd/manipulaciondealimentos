{
  "motion": {
    "duration": {
      "$type": "duration",
      "scene-fade": {
        "$value": "{primitive.duration.600}",
        "$description": "Each half of a scene change."
      },
      "morph": {
        "$value": "{primitive.duration.450}",
        "$description": "An element turning into another (View Transitions)."
      },
      "exit": {
        "$value": "{primitive.duration.350}",
        "$description": "An element leaving the screen, e.g. a swiped card."
      },
      "splash-hold": {
        "$value": "{primitive.duration.1000}",
        "$description": "How long the Studio LXD logo stays before fading out."
      },
      "title-hold": {
        "$value": "{primitive.duration.2500}",
        "$description": "How long an activity title stays before fading out."
      },
      "typewriter-char": {
        "$value": "{primitive.duration.28}"
      },
      "typewriter-pause": {
        "$value": "{primitive.duration.450}",
        "$description": "Pause after each sentence."
      },
      "icon-loop": {
        "$value": "{primitive.duration.3200}",
        "$description": "One cycle of an animated icon, e.g. the device turning."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{primitive.easing.ease-in-out}"
      },
      "enter": {
        "$value": "{primitive.easing.ease-out}"
      },
      "exit": {
        "$value": "{primitive.easing.ease-in}"
      }
    }
  }
}
